# Copy this to .env and fill it in. Never commit .env.

# The site's address, for links in emails and Stripe's return pages.
# Locally http://localhost:3000; on Vercel https://fontsandfooters.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres. Locally and on previews: a Neon branch, never the live
# database. Run `npm run db:migrate` after pulling a schema change.
DATABASE_URL=

# Signs the sign-in cookies. A long random string: openssl rand -base64 32
AUTH_SECRET=

# Email, through Resend. Outside the live site emails are only printed to
# the server log, unless EMAIL_REDIRECT_TO is set: then they all go there.
RESEND_API_KEY=
EMAIL_REDIRECT_TO=

# Text alerts to the studio phone (email-to-SMS), e.g. 6025551234@vtext.com
ADMIN_SMS_GATEWAY=

# Stripe. Test keys (sk_test_…) everywhere except the live site: the code
# refuses live keys anywhere else.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Uploads (Cloudinary): brand assets, design options, documents.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The robot check on the contact and sign-up forms (Cloudflare Turnstile).
# Leave both empty locally to skip it. On the live site, set both: the
# forms also have a trap field, a timing check and a limit per address,
# but the box is what stops most bots.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel sends this with its scheduled calls (vercel.json): the Growth
# numbers at midnight Arizona, the Leads Tool's nightly runs (1 to 5 AM),
# the 6 AM leads email, and the 7 AM housekeeping. Pick a new long random
# string for this project.
CRON_SECRET=

# The Growth page: a Plausible Stats API key, for everyone who visits each
# site, and a Google service account's JSON key, pasted whole, for reading
# each site's Search Console property. See GROWTH.md.
PLAUSIBLE_API_KEY=
GOOGLE_SEARCH_CONSOLE_KEY=

# The Leads Tool. See LEADS.md for what each one needs turned on.
# Google: Places API (New) and Routes API on this key (server only).
GOOGLE_MAPS_SERVER_KEY=
# Google: Maps Embed API on this key, restricted to your domains.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
ANTHROPIC_API_KEY=
# A master key: Apollo's people search needs one.
APOLLO_API_KEY=
APIFY_API_TOKEN=
SERPAPI_API_KEY=
TICKETMASTER_API_KEY=
# Optional: a different Apify actor for Eventbrite, or other AI models.
APIFY_EVENTBRITE_ACTOR=
LEADS_AI_MODEL=
LEADS_AI_FAST_MODEL=
